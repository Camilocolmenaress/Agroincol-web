# ---------------------------------------------------------------------------
# Meta: Pixel + API de Conversiones
#
# Sin estas variables el sitio funciona igual, solo sin medición. El Pixel no se
# carga y los endpoints responden 503 sin romper nada.
# ---------------------------------------------------------------------------

# Id del Pixel. Lo lee el navegador, por eso lleva NEXT_PUBLIC_.
NEXT_PUBLIC_META_PIXEL_ID=

# Token de la API de Conversiones. SOLO servidor: nunca ponerle NEXT_PUBLIC_,
# con ese prefijo quedaría dentro del JavaScript que descarga cualquiera.
# Se saca en: Administrador de eventos > Configuración > API de conversiones.
META_CAPI_TOKEN=

# Código de prueba para el "Probador de eventos" del Administrador de eventos.
# Dejar VACÍO en producción: con valor, los eventos entran como prueba y NO
# cuentan para optimizar campañas.
META_TEST_EVENT_CODE=

# ---------------------------------------------------------------------------
# PostHog: embudo, tiempo en página y grabaciones de sesión
# ---------------------------------------------------------------------------

NEXT_PUBLIC_POSTHOG_KEY=
# Región de la instancia. US por defecto; para la UE: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# ---------------------------------------------------------------------------
# Hoja de leads (Google Sheets + Apps Script)
#
# Ver docs/hoja-de-leads.md para el montaje completo. Sin estas variables el
# formulario sigue funcionando: simplemente no se guarda la fila ni sale el
# Purchase cuando se cierra un cliente.
# ---------------------------------------------------------------------------

# URL /exec del Apps Script publicado como aplicación web.
HOJA_LEADS_URL=

# Secreto compartido entre la página y el script. Solo servidor.
# Generar con: openssl rand -hex 24
HOJA_LEADS_SECRETO=

# ---------------------------------------------------------------------------
# Existentes
# ---------------------------------------------------------------------------

# A dónde se reenvían los leads del formulario.
WEBHOOK_URL=
# Zona Alivio (multi-zone). Sin esto no se añade el rewrite.
ALIVIO_ZONE_URL=

# ---------------------------------------------------------------------------
# EcoGel: hoja de pedidos (ver docs/hoja-de-pedidos.md)
# ---------------------------------------------------------------------------

HOJA_PEDIDOS_URL=
HOJA_PEDIDOS_SECRETO=
# Mercado Pago Checkout Pro. Access Token de la aplicación (APP_USR-… en producción).
MP_ACCESS_TOKEN=
